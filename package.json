{
  "name": "treino",
  "version": "1.0.0",
  "private": true,
  "description": "Planos de treino e registos pessoais com sincronizacao privada",
  "scripts": {
    "build": "esbuild src/supabase-client.js --bundle --minify --format=iife --outfile=vendor/supabase.js && node scripts/build-cloud.mjs",
    "test": "node --test tests/*.test.cjs",
    "test:browser": "node scripts/test-workout-browser.cjs",
    "catalog:coverage": "node scripts/catalog-coverage.cjs",
    "dev": "python3 -m http.server 8775",
    "test:sync-browser": "node scripts/test-sync-browser.cjs",
    "package:site": "node scripts/package-site.mjs",
    "security:install": "node scripts/install-gitleaks.mjs",
    "security:scan": "node scripts/check-secrets.cjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@playwright/cli": "0.1.23",
    "esbuild": "0.25.12"
  }
}
